---
import { site, categories } from '../data/site';
import { getPublishedArticles } from '../lib/articles';

// Só aparecem no menu as categorias que já têm artigo publicado.
const published = await getPublishedArticles();
const nav = [
  ...Object.entries(categories)
    .filter(([slug]) => published.some((a) => a.data.category === slug))
    .map(([slug, c]) => ({ label: c.name, href: `/${slug}/` })),
  { label: 'Sobre nosotros', href: '/sobre-nosotros/' },
];
---

<header class="relative border-b border-line bg-paper">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-paper focus:px-3 focus:py-2"
    >Saltar al contenido</a
  >
  <div class="container-page flex items-center justify-between gap-4 py-4">
    <a href="/" class="min-w-0 no-underline" aria-label={`${site.name}, inicio`}>
      <span class="block font-serif text-2xl font-bold leading-tight text-brand-900 sm:text-3xl">
        Hogar <span class="text-accent">Práctico</span>
      </span>
      <span class="mt-0.5 block text-xs text-muted sm:text-sm">{site.tagline}</span>
    </a>

    <div class="flex shrink-0 items-center gap-2 md:gap-6">
      <nav aria-label="Principal" class="hidden md:block">
        <ul class="flex gap-x-5 text-base">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="font-medium text-ink no-underline hover:text-brand-700">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a
        href="/buscar/"
        class="flex h-11 w-11 items-center justify-center rounded text-ink no-underline hover:text-brand-700"
        aria-label="Buscar en el sitio"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="m20 20-4.5-4.5"></path>
        </svg>
      </a>

      <!-- Menu de tracinhos no celular, sem JavaScript (<details>). -->
      <details class="menu-movil md:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded border-2 border-ink text-ink"
          aria-label="Abrir menú"
        >
          <svg class="icon-abrir" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg class="icon-cerrar" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </summary>
        <nav aria-label="Menú" class="absolute inset-x-0 top-full z-40 border-b border-line bg-paper shadow-lg">
          <ul class="container-page divide-y divide-line py-2">
            <li><a href="/" class="block py-3 font-medium text-ink no-underline">Inicio</a></li>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} class="block py-3 font-medium text-ink no-underline">
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li><a href="/buscar/" class="block py-3 font-medium text-ink no-underline">Buscar</a></li>
            <li><a href="/contacto/" class="block py-3 font-medium text-ink no-underline">Contacto</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .menu-movil summary::-webkit-details-marker {
    display: none;
  }
  .menu-movil .icon-cerrar,
  .menu-movil[open] .icon-abrir {
    display: none;
  }
  .menu-movil[open] .icon-cerrar {
    display: block;
  }
</style>
